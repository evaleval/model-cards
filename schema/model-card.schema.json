{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/evaleval/model-cards/main/schema/model-card.schema.json",
  "title": "Evaluation-focused Model Card publication contract",
  "description": "The seven-section public Model Card agreed for evaluation context. Private evidence, validation, lifecycle, environmental, and risk records are excluded.",
  "type": "object",
  "required": [
    "identity",
    "lineage",
    "specifications",
    "training_context",
    "access_and_adoption",
    "evaluation",
    "links"
  ],
  "properties": {
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "specifications": {
      "$ref": "#/$defs/specifications"
    },
    "training_context": {
      "$ref": "#/$defs/training_context"
    },
    "access_and_adoption": {
      "$ref": "#/$defs/access_and_adoption"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "links": {
      "$ref": "#/$defs/links"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modelReference": {
      "type": "object",
      "required": [
        "model_id",
        "relation"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[^/@\\s]+(?:/[^/@\\s]+)+$"
        },
        "relation": {
          "enum": [
            "base_model",
            "derivative_model"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "baseModelReference": {
      "allOf": [
        {
          "$ref": "#/$defs/modelReference"
        },
        {
          "properties": {
            "relation": {
              "const": "base_model"
            }
          }
        }
      ]
    },
    "derivativeModelReference": {
      "allOf": [
        {
          "$ref": "#/$defs/modelReference"
        },
        {
          "properties": {
            "relation": {
              "const": "derivative_model"
            }
          }
        }
      ]
    },
    "benchmarkScore": {
      "type": "object",
      "required": [
        "benchmark",
        "metric",
        "score",
        "setting"
      ],
      "properties": {
        "benchmark": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "setting": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "split": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "pattern": "^[^/@\\s]+(?:/[^/@\\s]+)+$"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "developed_by": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "model_type": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "release_date": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "base_models": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/baseModelReference"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "model_family": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "derivatives": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/derivativeModelReference"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "specifications": {
      "type": "object",
      "properties": {
        "architecture_type": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "num_parameters": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "context_length": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "precision": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "model_size": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "input_output": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "training_context": {
      "type": "object",
      "properties": {
        "training_data": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "training_data_size": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "data_cutoff": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "adaptations": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "access_and_adoption": {
      "type": "object",
      "properties": {
        "access_type": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "downloads": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "likes": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "results_summary": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "benchmark_scores": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/benchmarkScore"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "human_evals": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "safety_evals": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "model_card": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          ]
        },
        "system_card": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          ]
        },
        "tech_report": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          ]
        },
        "code_repository": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          ]
        },
        "citation": {
          "anyOf": [
            {
              "enum": [
                "Not specified",
                "Not applicable"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
