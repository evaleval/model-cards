        "missing_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseFieldPath"
          },
          "uniqueItems": true,
          "default": []
        },
        "coverage_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
