      "properties": {
        "overall_status": {
          "enum": [
            "not_run",
            "partial",
            "passed",
            "failed",
            "unavailable"
          ],
          "default": "not_run"
        },
        "checks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/checkSummary"
          },
          "default": {}
        },
        "flagged_fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldPath"
          },
          "additionalProperties": {
            "type": "array",
