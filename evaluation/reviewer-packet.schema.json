{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaleval.github.io/model-cards/evaluation/reviewer-packet.schema.json",
  "title": "Identity-redacted Model Card reviewer packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "study_unit_id",
    "condition",
    "target_blind_id",
    "target_sheet_sha256",
    "phase",
    "randomization_sha256",
    "item_manifest_sha256",
    "items",
    "privacy",
    "payload_sha256"
  ],
  "properties": {
    "packet_version": {"const": "model-card-reviewer-packet/v2"},
    "study_unit_id": {"$ref": "#/$defs/opaque_id"},
    "condition": {"enum": ["A", "B"]},
    "target_blind_id": {"$ref": "#/$defs/opaque_id"},
    "target_sheet_sha256": {"$ref": "#/$defs/digest"},
    "phase": {"enum": ["primary", "warning_followup"]},
    "randomization_sha256": {"$ref": "#/$defs/digest"},
    "item_manifest_sha256": {"$ref": "#/$defs/digest"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_identity_in_controlled_sheet",
        "treatment_identity_removed",
        "source_paths_removed",
        "source_uris_removed"
      ],
      "properties": {
        "target_identity_in_controlled_sheet": {"const": true},
        "treatment_identity_removed": {"const": true},
        "source_paths_removed": {"const": true},
        "source_uris_removed": {"const": true}
      }
    },
    "payload_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"phase": {"const": "primary"}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "allOf": [
                {"properties": {"item_kind": {"enum": ["claim", "field", "risk"]}}},
                {"not": {"required": ["warning_presentation"]}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"phase": {"const": "warning_followup"}},
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {"item_kind": {"const": "warning"}},
              "required": ["warning_presentation"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,127}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "excerpt", "coordinate_kind"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/opaque_id"},
        "kind": {"enum": ["quote", "structured"]},
        "excerpt": {"type": "string", "maxLength": 1600},
        "coordinate_kind": {"enum": ["character_range", "json_pointer"]}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_kind",
        "tasks",
        "field_path",
        "display_value",
        "evidence"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/opaque_id"},
        "item_kind": {"enum": ["claim", "field", "risk", "warning"]},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "claim_support",
              "assignment",
              "omission",
              "conflict_visibility",
              "risk_applicability",
              "warning_utility"
            ]
          }
        },
        "field_path": {"type": ["string", "null"], "maxLength": 256},
        "display_value": {},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "warning_presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "warning_present"],
          "properties": {
            "state": {"type": "string", "minLength": 1, "maxLength": 128},
            "warning_present": {"type": "boolean"}
          }
        }
      }
    }
  }
}
