{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaleval.github.io/model-cards/evaluation/target-sheet.schema.json",
  "title": "Condition-neutral exact-target sheet for Model Card reviewers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet_version",
    "study_unit_id",
    "target_blind_id",
    "exact_target",
    "assignment_instruction",
    "sheet_sha256"
  ],
  "properties": {
    "sheet_version": {"const": "model-card-reviewer-target-sheet/v1"},
    "study_unit_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{7,127}$"
    },
    "target_blind_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{7,127}$"
    },
    "exact_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 3, "maxLength": 471},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "assignment_instruction": {"type": "string", "minLength": 40, "maxLength": 600},
    "sheet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
